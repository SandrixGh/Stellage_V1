# ── Database ────────────────────────────────────────────────────────────────
db_name=stellage
db_user=postgres
db_password=changeme
db_host=localhost
db_port=5432
db_echo=false

# ── Application ──────────────────────────────────────────────────────────────
# "development" disables /docs in production; set "production" when deploying
environment=development
secret_key=change-this-to-a-long-random-string
frontend_url=http://localhost:5173
access_token_expire=3600
# Долгоживущий refresh-токен (сек). 2592000 = 30 дней.
refresh_token_expire=2592000
confirmation_code_length=6
# Set to true in production (HTTPS only)
cookie_secure=false
# Разрешённые CORS-origin'ы через запятую. frontend_url добавляется
# автоматически. В проде укажите реальный домен фронтенда.
cors_origins=http://localhost:5173,http://127.0.0.1:5173,http://172.18.0.1:5173
# Доверять X-Forwarded-For для rate limit ТОЛЬКО за доверенным обратным прокси
# (иначе клиент подделает IP). В проде за nginx/ingress — true.
trust_proxy_headers=false

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
email_host=smtp.gmail.com
email_port=465
email_username=your@gmail.com
email_password=your-app-password

# ── Redis ────────────────────────────────────────────────────────────────────
redis_host=localhost
redis_port=6379
redis_db=0

# ── RabbitMQ (Docker Compose only) ───────────────────────────────────────────
rabbitmq_user=stellage
rabbitmq_password=changeme

# ── PGAdmin (Docker Compose only) ────────────────────────────────────────────
pgadmin_email=admin@example.com
pgadmin_password=changeme

# ── S3 (box content storage) ─────────────────────────────────────────────────
# Локальная разработка (MinIO из docker-compose): endpoint http://localhost:9000,
# ключи станут MINIO_ROOT_USER/PASSWORD (пароль — минимум 8 символов).
# Прод (Selectel): s3_endpoint_url=https://s3.ru-1.storage.selcloud.ru,
# s3_public_endpoint_url не задавать.
s3_endpoint_url=http://localhost:9000
s3_region=ru-1
s3_access_key_id=stellage-local
s3_secret_access_key=change-me-min-8-chars
s3_bucket_name=stellage-boxes

# Необязательные (есть дефолты):
# s3_public_endpoint_url=   # браузерный endpoint, если отличается от внутреннего
# s3_addressing_style=path  # path (MinIO/Selectel) | virtual
# upload_url_expire_seconds=600
# download_url_expire_seconds=300
